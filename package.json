{
  "name": "edu-sql",
  "version": "0.1.0",
  "description": "SQL-детектив: тренажер баз даних і SQL для школярів, SQLite у браузері й сюжетні справи",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:lib": "rm -rf lib && tsc -p tsconfig.lib.json"
  },
  "exports": {
    ".": "./src/index.ts",
    "./core": {
      "types": "./lib/core/index.d.ts",
      "import": "./lib/core/index.js"
    }
  },
  "files": [
    "src",
    "lib",
    "!src/**/*.test.ts",
    "!src/demo"
  ],
  "dependencies": {
    "@types/sql.js": "1.4.11",
    "sql.js": "1.15.2"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
